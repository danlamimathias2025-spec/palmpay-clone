        </div>
        <div class="flex flex-col">
          <span
            class="text-base font-extrabold tracking-tight bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-transparent group-hover:from-cyan-300 group-hover:to-indigo-300 transition">
            ImageToURL
          </span>
          <span class="text-[10px] font-medium tracking-wider text-cyan-400/90 uppercase -mt-1 font-mono">
            Fast &amp; Private
          </span>
        </div>
      </a>

      <!-- Desktop Center Navigation -->
      <nav class="hidden md:flex items-center space-x-1">

        <!-- Tools Dropdown Trigger -->
        <div class="relative group" id="tools-dropdown-container">
          <button id="tools-menu-btn" type="button"
            class="flex items-center space-x-1.5 px-3 py-2 rounded-lg text-sm font-medium text-zinc-300 hover:text-white hover:bg-dark-card border border-transparent hover:border-dark-border transition">
            <i data-lucide="layout-grid" class="w-4 h-4 text-cyan-400"></i>
            <span data-i18n="navTools">Tools</span>
            <i data-lucide="chevron-down"
              class="w-3.5 h-3.5 text-zinc-400 group-hover:rotate-180 transition-transform duration-200"></i>
          </button>

          <!-- Tools Dropdown Menu -->
          <div id="tools-dropdown-menu"
            class="hidden absolute left-0 mt-2 w-80 bg-dark-card/95 backdrop-blur-2xl border border-dark-border rounded-2xl shadow-2xl shadow-black/80 p-2 z-50 grid grid-cols-1 gap-1">
            <!-- Dynamically populated via JS with localized tool names -->
          </div>
        </div>

        <a href="/contact" id="nav-link-contact"
          class="px-3 py-2 rounded-lg text-sm font-medium hover:text-white hover:bg-dark-card border hover:border-dark-border transition text-zinc-300 border-transparent"
          data-i18n="navContact">Contact Us</a>

        <a href="/privacy-policy" id="nav-link-privacy"
          class="px-3 py-2 rounded-lg text-sm font-medium hover:text-white hover:bg-dark-card border hover:border-dark-border transition text-zinc-300 border-transparent"
          data-i18n="navPrivacy">Privacy Policy</a>

        <a href="/terms" id="nav-link-terms"
          class="px-3 py-2 rounded-lg text-sm font-medium hover:text-white hover:bg-dark-card border hover:border-dark-border transition text-zinc-300 border-transparent"
          data-i18n="navTerms">Terms of Service</a>
      </nav>

      <!-- Right Action Items (History, Language Picker, Reset) -->
      <div class="flex items-center space-x-2">

        <!-- History / Recent Button -->
        <button id="open-history-btn" type="button" title="View Recent Uploads"
          class="relative p-2 rounded-xl text-zinc-400 hover:text-zinc-200 bg-dark-card hover:bg-dark-cardHover border border-dark-border transition">
          <i data-lucide="history" class="w-4 h-4"></i>
          <span id="history-badge"
            class="hidden absolute -top-1 -right-1 w-4 h-4 rounded-full bg-cyan-500 text-[9px] font-bold text-black flex items-center justify-center">0</span>
        </button>

        <!-- Reset Button -->
        <button id="nav-reset-btn" type="button" title="Clear Active Image"
          class="hidden sm:flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-zinc-400 hover:text-zinc-200 bg-dark-card hover:bg-dark-cardHover border border-dark-border transition">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          <span data-i18n="navReset">Reset</span>
        </button>

        <!-- Language Selector Dropdown -->
        <div class="relative" id="lang-dropdown-container">
          <button id="lang-menu-btn" type="button"
            class="flex items-center space-x-2 px-2.5 py-1.5 rounded-xl bg-dark-card hover:bg-dark-cardHover border border-dark-border hover:border-dark-borderHover text-sm font-medium text-zinc-200 transition">
            <span id="current-lang-flag" class="text-base">🇺🇸</span>
            <span id="current-lang-code" class="text-xs uppercase font-bold text-zinc-300">EN</span>
            <i data-lucide="chevron-down" class="w-3 h-3 text-zinc-400"></i>
          </button>

          <!-- Language Dropdown Popover -->
          <div id="lang-dropdown-menu"
            class="hidden absolute right-0 mt-2 w-56 max-h-96 overflow-y-auto bg-dark-card/95 backdrop-blur-2xl border border-dark-border rounded-2xl shadow-2xl shadow-black/80 p-1.5 z-50 divide-y divide-dark-border/50">
            <!-- Dynamically populated via JS with 14 languages -->
          </div>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" type="button"
          class="md:hidden p-2 rounded-xl bg-dark-card border border-dark-border text-zinc-300 hover:text-white transition">
          <i data-lucide="menu" id="mobile-menu-icon" class="w-5 h-5"></i>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu"
      class="hidden md:hidden border-t border-dark-border bg-[#08090d]/95 backdrop-blur-2xl px-4 pt-3 pb-6 space-y-4">
      <div class="text-xs font-semibold text-zinc-400 uppercase tracking-wider px-2" data-i18n="navTools">Tools</div>
      <div class="grid grid-cols-2 gap-2" id="mobile-tools-list">
        <!-- Dynamically rendered with localized tool titles -->
      </div>
      <div class="border-t border-dark-border pt-3 flex flex-col space-y-2">
        <a href="/contact" id="mobile-link-contact"
          class="mobile-nav-link flex items-center space-x-2 px-3 py-2 rounded-xl text-sm font-medium text-zinc-300 hover:bg-dark-card">
          <i data-lucide="mail" class="w-4 h-4 text-cyan-400"></i>
          <span data-i18n="navContact">Contact Us</span>
        </a>
        <a href="/privacy-policy" id="mobile-link-privacy"
          class="mobile-nav-link flex items-center space-x-2 px-3 py-2 rounded-xl text-sm font-medium text-zinc-300 hover:bg-dark-card">
          <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
          <span data-i18n="navPrivacy">Privacy Policy</span>
        </a>
        <a href="/terms" id="mobile-link-terms"
          class="mobile-nav-link flex items-center space-x-2 px-3 py-2 rounded-xl text-sm font-medium text-zinc-300 hover:bg-dark-card">
          <i data-lucide="file-text" class="w-4 h-4 text-indigo-400"></i>
          <span data-i18n="navTerms">Terms of Service</span>
        </a>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT VIEWS CONTAINER -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- VIEW 1: CONVERTER TOOL WORKSPACE -->
    <div id="view-converter" class="space-y-8 animate-in fade-in duration-300">

      <!-- HERO HEADER -->
      <section class="text-center space-y-4 max-w-3xl mx-auto">
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold shadow-inner shadow-cyan-500/10">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span id="hero-badge-text">Universal Converter</span>
          <span class="text-zinc-500">•</span>
          <span id="hero-ext-badge" class="font-mono text-[11px] text-zinc-400"></span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
          <span id="hero-title-prefix">Convert Any Image into</span>
          <span id="hero-title-gradient"
            class="bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent block mt-1">
            Direct URLs, Base64 &amp; Embeds
          </span>
        </h1>

        <p id="hero-subtitle" class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed">
          Upload, optimize, and generate production-ready HTML, Markdown, CSS, and Data URLs in seconds. 100% private
          in-browser processing.
        </p>

        <div id="hero-feature-pills" class="flex flex-wrap items-center justify-center gap-2 pt-2">
          <!-- Populated by JS in selected language -->
        </div>
      </section>

      <!-- DRAG & DROP UPLOAD ZONE -->
      <section class="max-w-4xl mx-auto">
        <div id="dropzone"
          class="relative group rounded-3xl border-2 border-dashed border-dark-border hover:border-cyan-500/60 bg-dark-surface/90 hover:bg-dark-card/90 transition-all duration-300 p-8 sm:p-12 text-center cursor-pointer shadow-2xl shadow-black/60 overflow-hidden">

          <div
            class="absolute inset-0 bg-gradient-to-b from-cyan-500/5 via-transparent to-indigo-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
          </div>

          <!-- Hidden Native File Input -->
          <input type="file" id="file-input" class="hidden" multiple accept="image/*" />

          <div class="relative z-10 flex flex-col items-center space-y-4">

            <div
              class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-b from-cyan-500/10 to-indigo-500/10 border border-cyan-500/20 flex items-center justify-center group-hover:scale-105 group-hover:border-cyan-500/40 transition duration-300 shadow-xl shadow-cyan-500/5">
              <i data-lucide="cloud-upload"
                class="w-8 h-8 sm:w-10 sm:h-10 text-cyan-400 group-hover:-translate-y-0.5 transition duration-300"></i>
            </div>

            <div class="space-y-1">
              <h3 id="dropzone-title" class="text-lg sm:text-xl font-bold text-white tracking-tight"
                data-i18n="dropzoneTitle">Drag &amp; drop your image here</h3>
              <p id="dropzone-sub" class="text-xs sm:text-sm text-zinc-400" data-i18n="dropzoneSubtitle">or click to
                browse from your device</p>
            </div>

            <button type="button"
              class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-semibold text-sm shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/40 transition duration-200">
              <span data-i18n="dropzoneBrowse">Browse Files</span>
            </button>

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-3 text-xs text-zinc-400 font-medium">
              <span
                class="flex items-center space-x-1.5 bg-dark-bg/80 px-2.5 py-1 rounded-lg border border-dark-border">
                <i data-lucide="clipboard-copy" class="w-3.5 h-3.5 text-cyan-400"></i>
                <span data-i18n="dropzonePasteHint">You can also paste directly with Ctrl + V / ⌘ + V</span>
              </span>
              <span class="flex items-center space-x-1.5 text-emerald-400/90">
                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-400"></i>
                <span data-i18n="featurePrivate">100% Local &amp; Private</span>
              </span>
            </div>

            <div
              class="pt-4 border-t border-dark-border/60 w-full flex flex-col sm:flex-row items-center justify-center gap-2">
