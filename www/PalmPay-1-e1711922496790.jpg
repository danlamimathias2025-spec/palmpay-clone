  <!-- EMBEDDED DATA & APPLICATION SCRIPT -->
  <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script src="assets/js/i18n-data.js"></script>
  <script>
    if (typeof TRANSLATIONS === 'undefined') {
      document.write('<script src="/assets/js/i18n-data.js"><\/script>');
    }
  </script>
  <script>
    function getToolInfo(toolId, lang = (typeof AppState !== 'undefined' ? AppState.currentLang : 'en')) {
      const meta = (typeof TOOLS_METADATA !== 'undefined' && TOOLS_METADATA.find(t => t.id === toolId)) || (typeof TOOLS_METADATA !== 'undefined' && TOOLS_METADATA[0]) || { id: toolId, name: toolId };
      const langDict = (typeof TOOLS_DATA !== 'undefined' && ((TOOLS_DATA[lang] && TOOLS_DATA[lang][toolId]) || (TOOLS_DATA.en && TOOLS_DATA.en[toolId]))) || {};
      return {
        ...meta,
        ...langDict
      };
    }

    // Helper to get all tools localized
    function getAllTools(lang = (typeof AppState !== 'undefined' ? AppState.currentLang : 'en')) {
      if (typeof TOOLS_METADATA === 'undefined') return [];
      return TOOLS_METADATA.map(m => getToolInfo(m.id, lang));
    }

    // Application State
    const AppState = {
      currentLang: 'en',
      currentTool: 'image-to-url',
      currentPage: 'image-to-url',
      images: [],
      activeIndex: 0,
      urlMode: 'dataUri',
      activeEmbedTab: 'direct',
      checkerboardMode: 'dark',
      recentUploads: [],
    };

    // --- LANGUAGE DETECTION & ROUTING ENGINE ---
    function detectLanguage() {
      if (typeof LANGUAGES === 'undefined' || !Array.isArray(LANGUAGES)) return 'en';

      // 1. Query parameter ?lang=es
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const qLang = urlParams.get('lang');
        if (qLang && LANGUAGES.some(l => l.code === qLang.toLowerCase())) {
          return qLang.toLowerCase();
        }
      } catch (e) {}

      // 2. URL Path segment /:lang/...
      const cleanPath = (window.location.pathname || '').replace(/^\/+|\/+$/g, '').trim();
      const segments = cleanPath.split('/').filter(Boolean);
      if (segments.length > 0) {
        const segLang = segments[0].toLowerCase();
        if (LANGUAGES.some(l => l.code === segLang)) {
          return segLang;
        }
      }

      // 3. Hash route #/:lang/... or #/es
      if (window.location.hash) {
        const cleanHash = window.location.hash.replace(/^#\/?/, '').trim();
        const hashSegs = cleanHash.split('/').filter(Boolean);
        if (hashSegs.length > 0) {
          const hashLang = hashSegs[0].toLowerCase();
          if (LANGUAGES.some(l => l.code === hashLang)) {
            return hashLang;
          }
        }
      }

      // 4. Saved user preference in localStorage
      try {
        const savedLang = localStorage.getItem('imagetourl_lang');
        if (savedLang && LANGUAGES.some(l => l.code === savedLang)) {
          return savedLang;
        }
      } catch (e) {}

      // 5. Cookie imagetourl_lang
      try {
        const m = document.cookie.match(/imagetourl_lang=([a-zA-Z\-]+)/);
        if (m && LANGUAGES.some(l => l.code === m[1].toLowerCase())) {
          return m[1].toLowerCase();
        }
      } catch (e) {}

      // 6. Browser language preference (navigator.language)
      try {
        if (typeof navigator !== 'undefined') {
          const browserLangs = navigator.languages ? Array.from(navigator.languages) : [navigator.language];
          for (const bLang of browserLangs) {
            if (!bLang) continue;
            const norm = bLang.toLowerCase();
            const direct = LANGUAGES.find(l => l.code === norm);
            const prefix = LANGUAGES.find(l => l.code === norm.split('-')[0]);
            const match = direct || prefix;
            if (match && match.code) {
              return match.code;
            }
          }
        }
      } catch (e) {}

      return 'en';
    }

    function parseRouteFromPath(pathname, fallbackLang) {
      const clean = (pathname || '').replace(/^\/+|\/+$/g, '').trim();
      const segments = clean.split('/').filter(Boolean);

      let lang = fallbackLang || detectLanguage();
      let page = 'image-to-url';

      if (segments.length === 0) {
        return { lang, page };
      }

      const isLang = typeof LANGUAGES !== 'undefined' && LANGUAGES.some(l => l.code === segments[0].toLowerCase());
      if (isLang) {
        lang = segments[0].toLowerCase();
        if (segments.length > 1) {
          page = segments[1].toLowerCase();
        }
      } else {
        page = segments[0].toLowerCase();
      }

      const validPages = [
        'image-to-url', 'png-to-url', 'jpg-to-url', 'webp-to-url',
        'svg-to-url', 'gif-to-url', 'image-to-base64', 'base64-to-image',
        'url-to-image', 'contact', 'privacy-policy', 'terms'
      ];

      if (!validPages.includes(page)) {
        page = 'image-to-url';
      }

      return { lang, page };
    }

    function parseCurrentRoute() {
      let path = window.location.pathname || '/';

      // Backward compatibility: Migrate legacy #/ routes cleanly
      if (window.location.hash && window.location.hash.startsWith('#')) {
        const rawHash = window.location.hash.replace(/^#\/?/, '').trim();
        if (rawHash) {
          path = '/' + rawHash;
        }
      }

      // Check query param ?lang=
      let explicitLang = null;
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const qLang = urlParams.get('lang');
        if (qLang && typeof LANGUAGES !== 'undefined' && LANGUAGES.some(l => l.code === qLang.toLowerCase())) {
          explicitLang = qLang.toLowerCase();
        }
      } catch (e) {}

      // Handle local file:// protocol or HTML file paths
      if (window.location.protocol === 'file:' || path.endsWith('.html') || path.endsWith('.htm')) {
        if (window.location.hash && window.location.hash.replace(/^#\/?/, '').trim()) {
          path = '/' + window.location.hash.replace(/^#\/?/, '').trim();
        } else {
          const lang = explicitLang || AppState.currentLang || detectLanguage();
          const page = AppState.currentPage || 'image-to-url';
          return { lang, page };
        }
      }

      const fallback = explicitLang || AppState.currentLang || detectLanguage();
      const route = parseRouteFromPath(path, fallback);
      if (explicitLang) {
        route.lang = explicitLang;
      }
      return route;
    }

    function buildRouteUrl(lang, page) {
      if (lang === 'en' && page === 'image-to-url') return '/';
      if (lang === 'en') return `/${page}`;
      if (page === 'image-to-url') return `/${lang}`;
      return `/${lang}/${page}`;
    }

    function navigateTo(lang, page, push = true) {
      const targetUrl = buildRouteUrl(lang, page);
      AppState.currentLang = lang;
      AppState.currentPage = page;

      try {
        if (window.location.protocol.startsWith('http')) {
          if (push && (window.location.pathname !== targetUrl || window.location.hash)) {
            window.history.pushState({ lang, page }, '', targetUrl);
          }
        } else {
          window.location.hash = '#/' + (lang === 'en' ? '' : lang + '/') + (page === 'image-to-url' ? '' : page);
        }
      } catch (e) {
        console.warn('History API notice:', e);
      }

      applyLanguageAndRoute(lang, page);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function applyLanguageAndRoute(lang, page) {
      AppState.currentLang = lang;
      AppState.currentPage = page;

      const langConfig = (typeof LANGUAGES !== 'undefined' && LANGUAGES.find(l => l.code === lang)) || { code: 'en', dir: 'ltr', flag: '🌐' };
      document.documentElement.lang = lang;
      document.documentElement.dir = langConfig.dir || 'ltr';

      const isTool = typeof TOOLS_METADATA !== 'undefined' && TOOLS_METADATA.some(t => t.id === page);
      if (isTool) {
        AppState.currentTool = page;
      }

      // 1. Immediately update all text translations across the entire page!
      updateI18nTexts();

      // 2. Update tool presentation (hero title, badge, subhead, feature pills)
      updateToolPresentation();

      // 3. Update view visibility
      updateViewVisibility(page);

      // 4. Update navbar and footer states
      updateNavbarStates();
      renderToolsMenus();
      renderFooterLanguageLinks();
      renderLanguageModalGrid();
      closeMobileMenu();

      // 5. Update SEO & meta tags safely
      updateSEOAndMeta(lang, page);

      if (window.lucide) lucide.createIcons();
    }

    function handleRouteUpdate() {
      const { lang, page } = parseCurrentRoute();
      applyLanguageAndRoute(lang, page);

      // Clean up legacy hash from browser address bar if present
      if (window.location.hash && window.location.protocol.startsWith('http') && !window.location.hash.startsWith('#/')) {
        try {
          window.history.replaceState({ lang, page }, '', buildRouteUrl(lang, page));
        } catch (e) { }
      }

      // Track Google Analytics SPA virtual pageview
      if (typeof gtag === 'function') {
        try {
          gtag('event', 'page_view', {
            page_path: window.location.pathname,
            page_title: document.title,
            language: lang
          });
        } catch (e) { }
      }

      // Trigger AdSense for SPA route transition
      try {
        if (typeof window !== 'undefined' && window.adsbygoogle) {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        }
      } catch (e) { }
    }

    function updateSEOAndMeta(lang, page) {
      try {
        const tool = getToolInfo(page, lang);
        let title = '';
        let desc = '';
        const langInfo = (typeof LANGUAGES !== 'undefined' ? LANGUAGES.find(l => l.code === lang) : null) || { code: lang, name: lang, nativeName: lang };
        const REGION_LABELS = {
          'en-gb': { tag: 'UK', in: 'in the UK' },
          'en-au': { tag: 'Australia', in: 'in Australia' },
          'en-ca': { tag: 'Canada', in: 'in Canada' },
          'fr-ca': { tag: 'Canada', in: 'au Canada' },
          'fr-ch': { tag: 'Suisse', in: 'en Suisse' },
          'de-ch': { tag: 'Schweiz', in: 'in der Schweiz' },
          'zh-tw': { tag: '台灣', in: '在台灣' },
        };
        const reg = REGION_LABELS[lang];
        const native = langInfo.nativeName || langInfo.name || lang;
        const langName = langInfo.name || lang;
        let suffix = '';
        if (reg) {
          suffix = ` (${reg.tag})`;
        } else if (lang !== 'en') {
          suffix = (native && native !== 'English') ? ` (${native})` : ` (${langName})`;
        }

        const dict = (typeof TRANSLATIONS !== 'undefined' && (TRANSLATIONS[lang] || TRANSLATIONS.en)) || {};

        if (typeof SEO_DATA !== 'undefined' && SEO_DATA && SEO_DATA[lang] && SEO_DATA[lang][page]) {
          title = SEO_DATA[lang][page].title;
          desc = SEO_DATA[lang][page].desc || SEO_DATA[lang][page].description;
        } else if (page === 'contact') {
          const baseTitle = dict.contactTitlePrefix ? `${dict.contactTitlePrefix} ${dict.contactTitleGrad || 'ImageToURL'}` : (dict.navContact || 'Contact Us');
          title = (lang !== 'en' ? `${baseTitle}${suffix}` : baseTitle) + ' - ImageToURL';
          const baseSub = dict.contactSubtitle || 'Have questions or feedback? Contact the ImageToURL team.';
          desc = `${baseSub.replace(/\.+$/, '')} (${langName}). Fast developer support and responses.`;
        } else if (page === 'privacy-policy') {
          const baseTitle = dict.privacyTitle || dict.navPrivacy || 'Privacy Policy';
          title = (lang !== 'en' ? `${baseTitle}${suffix}` : baseTitle) + ' - ImageToURL';
          desc = `ImageToURL ${baseTitle} (${langName}): 100% secure client-side processing in your browser with zero server uploads or data logging.`;
        } else if (page === 'terms') {
          const baseTitle = dict.termsTitle || dict.navTerms || 'Terms of Service';
          title = (lang !== 'en' ? `${baseTitle}${suffix}` : baseTitle) + ' - ImageToURL';
          desc = `ImageToURL ${baseTitle} (${langName}): Safe in-browser tool usage guidelines, intellectual property terms, and service conditions.`;
        } else if (tool && tool.name) {
          const toolHead = tool.headline || 'Convert Images to URLs';
          const toolSub = tool.subhead || 'Convert any image into direct URLs, Base64 Data URIs, HTML embed codes, and Markdown snippets.';
          title = `${tool.name} - ${toolHead}${lang !== 'en' ? suffix : ''} | ImageToURL`;
          if (reg) {
            desc = `${toolSub.replace(/\.+$/, '')} ${reg.in}. Instant client-side conversion.`;
          } else if (lang !== 'en') {
            desc = `${toolSub.replace(/\.+$/, '')} (${native}). 100% private in-browser conversion.`;
          } else {
            desc = toolSub;
          }
        }

        if (title) document.title = title;

        let descMeta = document.querySelector('meta[name="description"]');
        if (!descMeta) {
          descMeta = document.createElement('meta');
          descMeta.setAttribute('name', 'description');
          document.head.appendChild(descMeta);
        }
        if (desc) descMeta.setAttribute('content', desc);

        let ogTitle = document.querySelector('meta[property="og:title"]');
        if (ogTitle && title) ogTitle.setAttribute('content', title);

        let ogDesc = document.querySelector('meta[property="og:description"]');
        if (ogDesc && desc) ogDesc.setAttribute('content', desc);

        let twTitle = document.querySelector('meta[name="twitter:title"]');
        if (twTitle && title) twTitle.setAttribute('content', title);

        let twDesc = document.querySelector('meta[name="twitter:description"]');
        if (twDesc && desc) twDesc.setAttribute('content', desc);

        let canonical = document.querySelector('link[rel="canonical"]');
        if (canonical) {
          const routePath = buildRouteUrl(lang, page);
          canonical.setAttribute('href', 'https://www.imagetourl.org' + (routePath === '/' ? '/' : routePath));
        }
      } catch (err) {
        console.warn('SEO update notice:', err);
      }
    }

    function updateViewVisibility(page) {
      const views = {
        'view-converter': ['image-to-url', 'png-to-url', 'jpg-to-url', 'webp-to-url', 'svg-to-url', 'gif-to-url', 'image-to-base64'],
        'view-base64-to-image': ['base64-to-image'],
        'view-url-to-image': ['url-to-image'],
        'view-contact': ['contact'],
        'view-privacy': ['privacy-policy'],
        'view-terms': ['terms']
      };

      for (const [viewId, pageList] of Object.entries(views)) {
        const el = document.getElementById(viewId);
        if (el) {
          if (pageList.includes(page)) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        }
      }
    }

    function updateI18nTexts() {
      const lang = AppState.currentLang || 'en';
      const dict = (typeof TRANSLATIONS !== 'undefined' && (TRANSLATIONS[lang] || TRANSLATIONS.en)) || {};

      // Update textContent or innerHTML if HTML tags/entities are present
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict && dict[key] !== undefined) {
          const val = dict[key];
          if (val.includes('<') || val.includes('&')) {
            el.innerHTML = val;
          } else {
            el.textContent = val;
          }
        }
      });

      // Update placeholders
      document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (dict && dict[key] !== undefined) {
          el.setAttribute('placeholder', dict[key]);
        }
      });

      // Update tooltips / title attributes
      document.querySelectorAll('[data-i18n-title]').forEach(el => {
        const key = el.getAttribute('data-i18n-title');
        if (dict && dict[key] !== undefined) {
          el.setAttribute('title', dict[key]);
        }
      });
    }

    function updateNavbarStates() {
      const currentLang = AppState.currentLang || 'en';
      const langConfig = (typeof LANGUAGES !== 'undefined' && LANGUAGES.find(l => l.code === currentLang)) || (typeof LANGUAGES !== 'undefined' && LANGUAGES[0]) || { code: 'en', flag: '🌐', dir: 'ltr' };
      const flagEl = document.getElementById('current-lang-flag');
      const codeEl = document.getElementById('current-lang-code');
      if (flagEl) flagEl.textContent = langConfig.flag;
      if (codeEl) codeEl.textContent = langConfig.code.toUpperCase();

      // Maintain active language across all navigation links & brand logo
      const homeUrl = buildRouteUrl(currentLang, 'image-to-url');
      const contactUrl = buildRouteUrl(currentLang, 'contact');
      const privacyUrl = buildRouteUrl(currentLang, 'privacy-policy');
      const termsUrl = buildRouteUrl(currentLang, 'terms');

      const logoLink = document.getElementById('nav-logo-link');
      if (logoLink) logoLink.setAttribute('href', homeUrl);

      const navContact = document.getElementById('nav-link-contact');
      if (navContact) navContact.setAttribute('href', contactUrl);

      const navPrivacy = document.getElementById('nav-link-privacy');
      if (navPrivacy) navPrivacy.setAttribute('href', privacyUrl);

      const navTerms = document.getElementById('nav-link-terms');
      if (navTerms) navTerms.setAttribute('href', termsUrl);

      const mobContact = document.getElementById('mobile-link-contact');
      if (mobContact) mobContact.setAttribute('href', contactUrl);

      const mobPrivacy = document.getElementById('mobile-link-privacy');
      if (mobPrivacy) mobPrivacy.setAttribute('href', privacyUrl);

      const mobTerms = document.getElementById('mobile-link-terms');
      if (mobTerms) mobTerms.setAttribute('href', termsUrl);

      const footerHome = document.getElementById('footer-link-home');
      if (footerHome) footerHome.setAttribute('href', homeUrl);

      const footerContact = document.getElementById('footer-link-contact');
      if (footerContact) footerContact.setAttribute('href', contactUrl);

      const footerPrivacy = document.getElementById('footer-link-privacy');
      if (footerPrivacy) footerPrivacy.setAttribute('href', privacyUrl);

      const footerTerms = document.getElementById('footer-link-terms');
      if (footerTerms) footerTerms.setAttribute('href', termsUrl);

      const footerCopyHome = document.getElementById('footer-link-copyright-home');
      if (footerCopyHome) footerCopyHome.setAttribute('href', homeUrl);

      const resetBtn = document.getElementById('nav-reset-btn');
      if (resetBtn) {
        if (AppState.images.length > 0) {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }

      // Highlight active navigation links
      const navLinks = [
        { id: 'nav-link-contact', page: 'contact' },
        { id: 'nav-link-privacy', page: 'privacy-policy' },
        { id: 'nav-link-terms', page: 'terms' }
      ];
      navLinks.forEach(({ id, page }) => {
        const el = document.getElementById(id);
        if (el) {
          if (AppState.currentPage === page) {
            el.classList.add('text-white', 'bg-dark-card', 'border-dark-border');
            el.classList.remove('text-zinc-300', 'border-transparent');
          } else {
            el.classList.remove('text-white', 'bg-dark-card', 'border-dark-border');
            el.classList.add('text-zinc-300', 'border-transparent');
          }
        }
      });
    }

    function updateToolPresentation() {
      const tool = getToolInfo(AppState.currentTool, AppState.currentLang);

      const badgeText = document.getElementById('hero-badge-text');
      const extBadge = document.getElementById('hero-ext-badge');
      const titlePrefix = document.getElementById('hero-title-prefix');
      const titleGradient = document.getElementById('hero-title-gradient');
      const subtitle = document.getElementById('hero-subtitle');
      const pillsContainer = document.getElementById('hero-feature-pills');

      if (badgeText) badgeText.textContent = tool.badge || '';
      if (extBadge) extBadge.textContent = tool.ext || '';
      if (titlePrefix) titlePrefix.textContent = (tool.name || '') + ' - ';
      if (titleGradient) titleGradient.textContent = tool.headline || '';
      if (subtitle) subtitle.textContent = tool.subhead || '';

      const fileInput = document.getElementById('file-input');
      if (fileInput) {
        fileInput.setAttribute('accept', tool.accept || 'image/*');
      }

      if (pillsContainer && tool.features) {
        pillsContainer.innerHTML = tool.features.map(f => `
          <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full bg-dark-card border border-dark-border text-xs text-zinc-300 font-medium">
            <i data-lucide="check" class="w-3 h-3 text-cyan-400"></i>
            <span>${escapeHtml(f)}</span>
          </span>
        `).join('');
      }
    }

    function renderToolsMenus() {
      const tools = getAllTools(AppState.currentLang);
      const toolsMenu = document.getElementById('tools-dropdown-menu');
      const mobileToolsList = document.getElementById('mobile-tools-list');
      const footerToolsLinks = document.getElementById('footer-tools-links');

      if (toolsMenu) {
        toolsMenu.innerHTML = tools.map(t => `
          <a href="${buildRouteUrl(AppState.currentLang, t.id)}" class="flex items-center space-x-3 p-2.5 rounded-xl hover:bg-dark-bg border border-transparent hover:border-dark-border transition group">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr ${t.color} flex items-center justify-center text-black font-bold text-xs shadow">
              <i data-lucide="${t.icon}" class="w-4 h-4 text-white"></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold text-zinc-200 group-hover:text-cyan-300 truncate">${escapeHtml(t.name)}</div>
              <div class="text-[10px] text-zinc-400 truncate">${escapeHtml(t.badge)}</div>
            </div>
          </a>
        `).join('');
      }

      if (mobileToolsList) {
        mobileToolsList.innerHTML = tools.map(t => `
          <a href="${buildRouteUrl(AppState.currentLang, t.id)}" class="flex items-center space-x-2 p-2 rounded-xl bg-dark-card border border-dark-border text-xs text-zinc-300">
            <i data-lucide="${t.icon}" class="w-3.5 h-3.5 text-cyan-400"></i>
            <span class="truncate">${escapeHtml(t.name)}</span>
          </a>
        `).join('');
      }

      if (footerToolsLinks) {
        footerToolsLinks.innerHTML = tools.map(t => `
          <a href="${buildRouteUrl(AppState.currentLang, t.id)}" class="text-zinc-400 hover:text-cyan-400 transition flex items-center space-x-1.5 py-1">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-500/50"></span>
            <span>${escapeHtml(t.name)}</span>
          </a>
        `).join('');
      }
    }

    function renderFooterLanguageLinks() {
      const footerLangLinks = document.getElementById('footer-language-links');
      if (footerLangLinks && typeof LANGUAGES !== 'undefined' && Array.isArray(LANGUAGES)) {
        footerLangLinks.innerHTML = LANGUAGES.map(l => `
          <a href="${buildRouteUrl(l.code, AppState.currentPage)}" class="text-zinc-400 hover:text-cyan-400 transition flex items-center space-x-1.5 py-1">
            <span>${l.flag}</span>
            <span>${escapeHtml(l.nativeName || l.name)}</span>
          </a>
        `).join('');
      }
    }


    // --- LANGUAGE SELECTION MODAL LOGIC (42 Languages Grid) ---
    function renderLanguageModalGrid(filter = '') {
      const grid = document.getElementById('modal-language-grid');
      const emptyEl = document.getElementById('modal-lang-empty');
      if (!grid) return;
      if (typeof LANGUAGES === 'undefined' || !Array.isArray(LANGUAGES)) return;

      const q = filter.trim().toLowerCase();
      const filtered = LANGUAGES.filter(l => {
        if (!q) return true;
        return l.name.toLowerCase().includes(q) ||
          l.nativeName.toLowerCase().includes(q) ||
          l.code.toLowerCase().includes(q);
      });

      if (filtered.length === 0) {
        grid.innerHTML = '';
        if (emptyEl) emptyEl.classList.remove('hidden');
        return;
      }
      if (emptyEl) emptyEl.classList.add('hidden');

      grid.innerHTML = filtered.map(l => {
        const isActive = l.code === AppState.currentLang;
        return `
          <button type="button" onclick="switchLanguage('${l.code}'); closeLanguageModal();" class="flex items-center space-x-2.5 px-3 py-2.5 rounded-xl border text-xs font-medium transition text-left group ${isActive
            ? 'border-cyan-500 bg-cyan-500/10 text-cyan-500 dark:text-cyan-400 font-semibold shadow-sm'
            : 'border-zinc-200 dark:border-dark-border bg-white dark:bg-dark-card text-zinc-700 dark:text-zinc-200 hover:border-zinc-400 dark:hover:border-zinc-600 hover:bg-zinc-50 dark:hover:bg-dark-cardHover'
          }">
            <span class="text-base shrink-0 select-none">${l.flag}</span>
            <span class="truncate">${escapeHtml(l.nativeName || l.name)}</span>
          </button>
        `;
      }).join('');
    }

    function openLanguageModal() {
      const modal = document.getElementById('language-modal');
      if (!modal) return;
      const searchInput = document.getElementById('lang-modal-search');
      if (searchInput) searchInput.value = '';
      renderLanguageModalGrid();
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (searchInput) {
        setTimeout(() => searchInput.focus(), 60);
      }
      if (window.lucide) lucide.createIcons();
    }

    function closeLanguageModal() {
      const modal = document.getElementById('language-modal');
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    function switchLanguage(langCode) {
      if (!langCode || (typeof LANGUAGES !== 'undefined' && !LANGUAGES.some(l => l.code === langCode))) return;
      try {
        localStorage.setItem('imagetourl_lang', langCode);
        document.cookie = `imagetourl_lang=${langCode}; path=/; max-age=31536000; SameSite=Lax`;
      } catch (e) { }
      const page = (typeof AppState !== 'undefined' && AppState.currentPage) ? AppState.currentPage : 'image-to-url';
      navigateTo(langCode, page);
      const langMenu = document.getElementById('lang-dropdown-menu');
      if (langMenu) langMenu.classList.add('hidden');
      closeLanguageModal();
    }

    function closeMobileMenu() {
      const m = document.getElementById('mobile-menu');
      if (m) m.classList.add('hidden');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // --- CORE IMAGE ENGINE & FILE HANDLING ---
    function handleFilesSelected(files) {
      if (!files || files.length === 0) return;

      const validFiles = Array.from(files).filter(f => f.type.startsWith('image/'));
      if (validFiles.length === 0) {
        showToast('Please select valid image files', 'warning');
        return;
      }

      validFiles.forEach(file => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const dataUri = e.target.result;
          const img = new Image();
          img.onload = () => {
            const imgData = {
              id: 'img_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
              name: file.name,
              size: file.size,
              mimeType: file.type,
              width: img.width,
              height: img.height,
              aspectRatio: calculateAspectRatio(img.width, img.height),
              dataUri: dataUri,
              originalFile: file,
              palette: extractDominantColors(img),
            };

            AppState.images.push(imgData);
            AppState.activeIndex = AppState.images.length - 1;

            // Save to recent uploads (localStorage)
            saveToRecent(imgData);

            // Update UI
            updateWorkspacePresentation();
            updateNavbarStates();
            updateRecentBadge();
            showToast(`Loaded ${file.name}`, 'success');
          };
          img.src = dataUri;
        };
        reader.readAsDataURL(file);
      });
    }

    function calculateAspectRatio(w, h) {
      if (!w || !h) return '1:1';
      function gcd(a, b) {
        return b === 0 ? a : gcd(b, a % b);
      }
      const r = gcd(w, h);
      const aspectW = Math.round(w / r);
      const aspectH = Math.round(h / r);
      if (aspectW > 100 || aspectH > 100) {
        return (w / h).toFixed(2) + ':1';
      }
      return `${aspectW}:${aspectH}`;
    }

    function formatBytes(bytes, decimals = 1) {
      if (!bytes || bytes === 0) return '0 B';
      const k = 1024;
      const dm = decimals < 0 ? 0 : decimals;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    function updateWorkspacePresentation() {
      const ws = document.getElementById('active-workspace');
      if (!ws) return;

      if (AppState.images.length === 0) {
        ws.classList.add('hidden');
        return;
      }

      ws.classList.remove('hidden');
      const activeImg = AppState.images[AppState.activeIndex];
      if (!activeImg) return;

      // Update Preview Elements
      const prevName = document.getElementById('preview-file-name');
      const prevImg = document.getElementById('preview-img');
      const statDims = document.getElementById('stat-dimensions');
      const statRatio = document.getElementById('stat-ratio');
      const statSize = document.getElementById('stat-size');
      const statFmt = document.getElementById('stat-format');

      if (prevName) prevName.textContent = activeImg.name;
      if (prevImg) prevImg.src = activeImg.dataUri;
      if (statDims) statDims.textContent = `${activeImg.width} × ${activeImg.height}`;
      if (statRatio) statRatio.textContent = activeImg.aspectRatio;
      if (statSize) statSize.textContent = formatBytes(activeImg.size);
      if (statFmt) statFmt.textContent = (activeImg.mimeType.split('/')[1] || 'PNG').toUpperCase();

      // Update Inputs
      const wInput = document.getElementById('opt-width-input');
      const hInput = document.getElementById('opt-height-input');
      if (wInput) wInput.value = activeImg.width;
      if (hInput) hInput.value = activeImg.height;

      // Update Palette
      renderPalette(activeImg.palette);

      // Update Batch Strip
      renderBatchThumbnails();

      // Update Code Snippets
      renderActiveCodeSnippet();
    }

    function renderBatchThumbnails() {
      const bar = document.getElementById('batch-switcher-bar');
      const strip = document.getElementById('batch-thumbnails');
      if (!bar || !strip) return;

      if (AppState.images.length <= 1) {
        bar.classList.add('hidden');
        return;
      }

      bar.classList.remove('hidden');
      strip.innerHTML = AppState.images.map((img, idx) => `
        <button type="button" onclick="selectActiveImage(${idx})" class="relative p-1 rounded-xl border ${idx === AppState.activeIndex ? 'border-cyan-400 bg-cyan-500/10 glow-cyan' : 'border-dark-border hover:border-dark-borderHover bg-dark-bg'} transition">
          <img src="${img.dataUri}" class="w-10 h-10 object-cover rounded-lg" />
          <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-dark-card border border-dark-border text-[9px] text-zinc-300 font-bold flex items-center justify-center">${idx + 1}</span>
        </button>
      `).join('');
    }

    window.selectActiveImage = function (index) {
      if (AppState.images[index]) {
        AppState.activeIndex = index;
        updateWorkspacePresentation();
      }
    };

    function extractDominantColors(imgEl) {
      try {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = 40;
        canvas.height = 40;
        ctx.drawImage(imgEl, 0, 0, 40, 40);
        const data = ctx.getImageData(0, 0, 40, 40).data;

        const colorMap = {};
        for (let i = 0; i < data.length; i += 16) {
          const r = Math.round(data[i] / 32) * 32;
          const g = Math.round(data[i + 1] / 32) * 32;
          const b = Math.round(data[i + 2] / 32) * 32;
          const a = data[i + 3];
          if (a > 128) {
            const hex = "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
            colorMap[hex] = (colorMap[hex] || 0) + 1;
          }
        }

        const sorted = Object.entries(colorMap).sort((a, b) => b[1] - a[1]);
        const colors = sorted.slice(0, 5).map(item => item[0]);
        return colors.length > 0 ? colors : ['#06b6d4', '#3b82f6', '#6366f1', '#0f172a', '#ffffff'];
      } catch (e) {
        return ['#06b6d4', '#3b82f6', '#6366f1', '#0f172a', '#ffffff'];
      }
    }

    function renderPalette(colors) {
      const swatches = document.getElementById('palette-swatches');
      if (!swatches) return;
      swatches.innerHTML = colors.map(hex => `
        <button type="button" onclick="copyHexColor('${hex}')" title="Copy ${hex}" class="flex-1 h-9 rounded-xl border border-white/10 hover:scale-105 active:scale-95 transition shadow-sm relative group overflow-hidden" style="background-color: ${hex}">
          <span class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 bg-black/50 text-[10px] font-mono text-white font-bold transition">${hex}</span>
        </button>
      `).join('');
    }

    window.copyHexColor = function (hex) {
      navigator.clipboard.writeText(hex);
      showToast(`Copied ${hex} to clipboard!`, 'success');
    };

    // --- CODE SNIPPET GENERATORS ---
    function renderActiveCodeSnippet() {
      const activeImg = AppState.images[AppState.activeIndex];
      if (!activeImg) return;

      const codeArea = document.getElementById('code-snippet-area');
      const label = document.getElementById('code-tab-label');
      const sizeLabel = document.getElementById('code-size-label');
      const qrContainer = document.getElementById('qr-code-container');
      const codeContainer = document.getElementById('code-snippet-container');

      const urlValue = AppState.urlMode === 'dataUri' ? activeImg.dataUri : (window.location.origin + '/uploads/' + activeImg.name);

      if (AppState.activeEmbedTab === 'qr') {
        codeContainer.classList.add('hidden');
        qrContainer.classList.remove('hidden');
        generateQrCode(urlValue);
        return;
      }

      codeContainer.classList.remove('hidden');
      qrContainer.classList.add('hidden');

      let snippet = '';
      let tabName = 'Direct URL';

      switch (AppState.activeEmbedTab) {
        case 'direct':
          snippet = urlValue;
          tabName = AppState.urlMode === 'dataUri' ? 'Data URI Link' : 'Hosted Image URL';
          break;
        case 'html':
          snippet = `<img src="${urlValue}" alt="${escapeHtml(activeImg.name)}" width="${activeImg.width}" height="${activeImg.height}" loading="lazy" />`;
          tabName = 'HTML <img> Tag';
          break;
        case 'markdown':
          snippet = `![${escapeHtml(activeImg.name)}](${urlValue})`;
          tabName = 'Markdown Image';
          break;
        case 'css':
          snippet = `background-image: url("${urlValue}");
background-size: contain;
background-repeat: no-repeat;`;
          tabName = 'CSS Rule';
          break;
        case 'react':
          snippet = `import React from 'react';

export const BannerImage = () => (
  <img 
    src="${urlValue}" 
    alt="${escapeHtml(activeImg.name)}" 
    width={${activeImg.width}} 
    height={${activeImg.height}} 
    className="rounded-xl object-contain max-w-full" 
  />
);`;
          tabName = 'React JSX Component';
          break;
        case 'bbcode':
          snippet = `[img]${urlValue}[/img]`;
          tabName = 'BBCode Forum Tag';
          break;
        case 'rawbase64':
          snippet = activeImg.dataUri.split(',')[1] || activeImg.dataUri;
          tabName = 'Raw Base64 String';
          break;
        default:
          snippet = urlValue;
          tabName = 'Direct URL';
      }

      if (codeArea) codeArea.value = snippet;
      if (label) label.textContent = tabName;
      if (sizeLabel) sizeLabel.textContent = `${snippet.length.toLocaleString()} chars`;
    }

    let qrcodeObj = null;
    function generateQrCode(text) {
      const target = document.getElementById('qrcode-render-target');
      if (!target) return;
      target.innerHTML = '';
      if (window.QRCode) {
        qrcodeObj = new QRCode(target, {
          text: text,
          width: 180,
          height: 180,
          colorDark: "#08090d",
          colorLight: "#ffffff",
          correctLevel: QRCode.CorrectLevel.M
        });
      }
    }

    // --- RECENT UPLOADS STORAGE ---
    function saveToRecent(imgData) {
      try {
        let recent = JSON.parse(localStorage.getItem('imagetourl_recent') || '[]');
        // Store lightweight summary (don't store full multi-megabyte Base64 to prevent storage quota crash)
        const summary = {
          name: imgData.name,
          width: imgData.width,
          height: imgData.height,
          size: imgData.size,
          mimeType: imgData.mimeType,
          dataUri: imgData.dataUri.length < 500000 ? imgData.dataUri : imgData.dataUri.slice(0, 50000) + '...',
          fullDataUri: imgData.dataUri.length < 1500000 ? imgData.dataUri : null,
          timestamp: Date.now()
        };
        recent.unshift(summary);
        recent = recent.slice(0, 10);
        localStorage.setItem('imagetourl_recent', JSON.stringify(recent));
      } catch (e) {
        console.warn('LocalStorage save failed:', e);
      }
    }

    function updateRecentBadge() {
      const recent = JSON.parse(localStorage.getItem('imagetourl_recent') || '[]');
      const badge = document.getElementById('history-badge');
      if (badge) {
        if (recent.length > 0) {
          badge.textContent = recent.length;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      const colors = {
        success: 'bg-emerald-950/90 border-emerald-500/40 text-emerald-300',
        warning: 'bg-amber-950/90 border-amber-500/40 text-amber-300',
        info: 'bg-dark-card/95 border-cyan-500/40 text-cyan-300'
      };

      toast.className = `flex items-center space-x-2 px-4 py-3 rounded-2xl border backdrop-blur-xl shadow-2xl text-xs font-medium animate-in slide-in-from-bottom duration-200 pointer-events-auto ${colors[type] || colors.info}`;
      toast.innerHTML = `
        <i data-lucide="${type === 'success' ? 'check-circle-2' : 'info'}" class="w-4 h-4"></i>
        <span>${escapeHtml(message)}</span>
      `;

      container.appendChild(toast);
      if (window.lucide) lucide.createIcons();

      setTimeout(() => {
        toast.classList.add('opacity-0', 'transition-opacity', 'duration-300');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // --- RE-ENCODE / OPTIMIZATION ---
    function applyOptimization() {
      const activeImg = AppState.images[AppState.activeIndex];
      if (!activeImg) return;

      const wInput = document.getElementById('opt-width-input');
      const hInput = document.getElementById('opt-height-input');
      const fmtSelect = document.getElementById('opt-format-select');
      const qualityRange = document.getElementById('opt-quality-range');

      const targetWidth = parseInt(wInput.value, 10) || activeImg.width;
      const targetHeight = parseInt(hInput.value, 10) || activeImg.height;
      const targetFormat = fmtSelect.value === 'original' ? activeImg.mimeType : fmtSelect.value;
      const quality = (parseInt(qualityRange.value, 10) || 90) / 100;

      const canvas = document.createElement('canvas');
      canvas.width = targetWidth;
      canvas.height = targetHeight;
      const ctx = canvas.getContext('2d');

      const img = new Image();
      img.onload = () => {
        ctx.drawImage(img, 0, 0, targetWidth, targetHeight);
        const newDataUri = canvas.toDataURL(targetFormat, quality);

        // Calculate new approx size
        const head = `data:${targetFormat};base64,`;
        const b64Length = newDataUri.length - head.length;
        const newSizeBytes = Math.round((b64Length * 3) / 4);

        activeImg.dataUri = newDataUri;
        activeImg.width = targetWidth;
        activeImg.height = targetHeight;
        activeImg.size = newSizeBytes;
        activeImg.mimeType = targetFormat;
        activeImg.aspectRatio = calculateAspectRatio(targetWidth, targetHeight);

        updateWorkspacePresentation();
        showToast('Image re-encoded successfully!', 'success');
      };
      img.src = activeImg.dataUri;
    }

    // --- SUBVIEWS CONTROLLERS ---
    function initBase64Decoder() {
      const decodeBtn = document.getElementById('b64-decode-btn');
      const clearBtn = document.getElementById('b64-clear-btn');
      const sampleBtn = document.getElementById('b64-paste-sample-btn');
      const input = document.getElementById('b64-input-area');
      const resultArea = document.getElementById('b64-result-area');
      const resultImg = document.getElementById('b64-result-img');
      const badge = document.getElementById('b64-meta-badge');
      const downloadBtn = document.getElementById('b64-download-btn');

      if (sampleBtn) {
        sampleBtn.addEventListener('click', () => {
          input.value = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400"><rect width="400" height="400" fill="%2306b6d4" rx="40"/><circle cx="200" cy="200" r="100" fill="%23ffffff"/><text x="200" y="210" font-size="32" font-family="sans-serif" font-weight="bold" fill="%2306b6d4" text-anchor="middle">IMAGETOURL</text></svg>';
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          resultArea.classList.add('hidden');
        });
      }

      if (decodeBtn) {
        decodeBtn.addEventListener('click', () => {
          let val = input.value.trim();
          if (!val) {
            showToast('Please paste a Base64 string or Data URI', 'warning');
            return;
          }

          if (!val.startsWith('data:')) {
            val = 'data:image/png;base64,' + val;
          }

          const img = new Image();
          img.onload = () => {
            resultImg.src = val;
            badge.textContent = `${img.width} × ${img.height} px`;
            resultArea.classList.remove('hidden');
            showToast('Decoded successfully!', 'success');
          };
          img.onerror = () => {
            showToast('Invalid image data URI or Base64 string', 'warning');
          };
          img.src = val;
        });
      }

      if (downloadBtn) {
        downloadBtn.addEventListener('click', () => {
          const a = document.createElement('a');
          a.href = resultImg.src;
          a.download = `decoded-image-${Date.now()}.png`;
          document.body.appendChild(a);
          a.click();
          a.remove();
        });
      }
    }

    function initUrlFetcher() {
      const fetchBtn = document.getElementById('fetch-url-btn');
      const input = document.getElementById('fetch-url-input');
      const demo1 = document.getElementById('demo-url-1');
      const demo2 = document.getElementById('demo-url-2');

      if (demo1) {
        demo1.addEventListener('click', () => {
          input.value = 'https://upload.wikimedia.org/wikipedia/commons/6/63/Wikipedia-logo.png';
        });
      }

      if (demo2) {
        demo2.addEventListener('click', () => {
          input.value = 'https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png';
        });
      }

      if (fetchBtn) {
        fetchBtn.addEventListener('click', () => {
          const url = input.value.trim();
          if (!url) {
            showToast('Please enter a valid image URL', 'warning');
            return;
          }

          showToast('Loading image from URL...', 'info');

          // Convert image URL to Data URI via canvas
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0);

            try {
              const dataUri = canvas.toDataURL('image/png');
              const blob = dataURItoBlob(dataUri);
              const filename = url.split('/').pop().split('?')[0] || 'web-image.png';
              const file = new File([blob], filename, { type: 'image/png' });

              // Switch to main converter view
              navigateTo(AppState.currentLang, 'image-to-url');
              handleFilesSelected([file]);
            } catch (err) {
              showToast('CORS prevented direct canvas read. Opening in preview.', 'warning');
            }
          };
          img.onerror = () => {
            showToast('Failed to load image. Check URL or CORS permissions.', 'warning');
          };
          img.src = url;
        });
      }
    }

    function dataURItoBlob(dataURI) {
      const byteString = atob(dataURI.split(',')[1]);
      const mimeString = dataURI.split(',')[0].split(':')[1].split(';')[0];
      const ab = new ArrayBuffer(byteString.length);
      const ia = new Uint8Array(ab);
      for (let i = 0; i < byteString.length; i++) {
        ia[i] = byteString.charCodeAt(i);
      }
      return new Blob([ab], { type: mimeString });
    }

    function initContactForm() {
      const form = document.getElementById('contact-form');
      const msgArea = document.getElementById('contact-message');
      const charCount = document.getElementById('contact-char-count');
      const successCard = document.getElementById('contact-success-card');
      const resetBtn = document.getElementById('contact-reset-form-btn');

      if (msgArea && charCount) {
        msgArea.addEventListener('input', (e) => {
          charCount.textContent = `${e.target.value.length} / 1000`;
        });
      }

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successCard.classList.remove('hidden');
          showToast('Message sent successfully!', 'success');
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          charCount.textContent = '0 / 1000';
          form.classList.remove('hidden');
          successCard.classList.add('hidden');
        });
      }
    }

    function initFaq() {
      document.querySelectorAll('.faq-item').forEach(item => {
        item.addEventListener('click', () => {
          const content = item.querySelector('.faq-content');
          const icon = item.querySelector('.faq-icon');
          const isHidden = content.classList.contains('hidden');

          document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
          document.querySelectorAll('.faq-icon').forEach(i => i.classList.remove('rotate-180'));

          if (isHidden) {
            content.classList.remove('hidden');
            icon.classList.add('rotate-180');
          }
        });
      });
    }

    function loadSampleSvg(svgString, name) {
      const dataUrl = `data:image/svg+xml;utf8,${encodeURIComponent(svgString)}`;
      const blob = dataURItoBlob(dataUrl);
      const file = new File([blob], name, { type: 'image/svg+xml' });
      handleFilesSelected([file]);
    }

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Dropzone & File Input Listeners
      const dropzone = document.getElementById('dropzone');
      const fileInput = document.getElementById('file-input');

      dropzone.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', (e) => handleFilesSelected(e.target.files));

      ['dragenter', 'dragover'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('border-cyan-400', 'bg-cyan-500/5', 'glow-cyan');
        });
      });

      ['dragleave', 'drop'].forEach(name => {
        dropzone.addEventListener(name, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('border-cyan-400', 'bg-cyan-500/5', 'glow-cyan');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files) {
          handleFilesSelected(dt.files);
        }
      });

      // 2. Global Clipboard Paste
      window.addEventListener('paste', (e) => {
        const items = (e.clipboardData || e.originalEvent.clipboardData).items;
        const filesToProcess = [];
        for (const item of items) {
          if (item.type.indexOf('image') !== -1) {
            const blob = item.getAsFile();
            if (blob) {
              const filename = `clipboard-screenshot-${Date.now()}.png`;
              filesToProcess.push(new File([blob], filename, { type: blob.type || 'image/png' }));
            }
          }
        }

        if (filesToProcess.length > 0) {
          handleFilesSelected(filesToProcess);
          showToast('Pasted image from clipboard!', 'success');
        }
      });

      // 3. Sample Buttons
      document.getElementById('sample-aura-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        const auraSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600"><defs><linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#06b6d4"/><stop offset="50%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs><rect width="800" height="600" fill="#08090d"/><circle cx="400" cy="300" r="180" fill="url(#g)" opacity="0.8"/><circle cx="340" cy="240" r="40" fill="white" opacity="0.3"/><text x="400" y="520" fill="#e2e8f0" font-family="sans-serif" font-size="22" font-weight="700" text-anchor="middle" letter-spacing="3">MODERN AURA GRADIENT</text></svg>';
        loadSampleSvg(auraSvg, 'modern-aura.svg');
      });

      document.getElementById('sample-geo-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        const geoSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="600" height="600"><defs><linearGradient id="neon" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#10b981"/><stop offset="100%" stop-color="#06b6d4"/></linearGradient></defs><rect width="600" height="600" rx="36" fill="#0e111a"/><polygon points="300,120 480,450 120,450" fill="none" stroke="url(#neon)" stroke-width="14" stroke-linejoin="round"/><circle cx="300" cy="330" r="60" fill="url(#neon)"/><text x="300" y="525" fill="#94a3b8" font-family="sans-serif" font-size="18" font-weight="700" text-anchor="middle" letter-spacing="4">CYBER GEO SHAPE</text></svg>';
        loadSampleSvg(geoSvg, 'cyber-geo.svg');
      });

      // 4. Checkerboard Mode Switcher
      const stage = document.getElementById('preview-stage');
      document.getElementById('bg-checker-dark').addEventListener('click', () => {
        stage.className = 'relative w-full h-64 sm:h-72 rounded-2xl checkerboard-dark border border-dark-border/80 flex items-center justify-center overflow-hidden group';
      });
      document.getElementById('bg-checker-light').addEventListener('click', () => {
        stage.className = 'relative w-full h-64 sm:h-72 rounded-2xl checkerboard-light border border-dark-border/80 flex items-center justify-center overflow-hidden group';
      });
      document.getElementById('bg-solid-dark').addEventListener('click', () => {
        stage.className = 'relative w-full h-64 sm:h-72 rounded-2xl bg-black border border-dark-border/80 flex items-center justify-center overflow-hidden group';
      });
      document.getElementById('bg-solid-light').addEventListener('click', () => {
        stage.className = 'relative w-full h-64 sm:h-72 rounded-2xl bg-white border border-dark-border/80 flex items-center justify-center overflow-hidden group';
      });

      // 5. Lightbox Modal
      const lightbox = document.getElementById('lightbox-modal');
      const lightboxImg = document.getElementById('lightbox-img');
      document.getElementById('open-lightbox-btn').addEventListener('click', () => {
        const activeImg = AppState.images[AppState.activeIndex];
        if (activeImg) {
          lightboxImg.src = activeImg.dataUri;
          lightbox.classList.remove('hidden');
        }
      });
      document.getElementById('close-lightbox-btn').addEventListener('click', () => {
        lightbox.classList.add('hidden');
      });
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) lightbox.classList.add('hidden');
      });

      // 6. Quick Actions (Copy Data URL & Download)
      document.getElementById('quick-copy-url-btn').addEventListener('click', () => {
        const activeImg = AppState.images[AppState.activeIndex];
        if (activeImg) {
          navigator.clipboard.writeText(activeImg.dataUri);
          showToast('Data URL copied to clipboard!', 'success');
        }
      });

      document.getElementById('quick-download-btn').addEventListener('click', () => {
        const activeImg = AppState.images[AppState.activeIndex];
        if (activeImg) {
          const a = document.createElement('a');
          a.href = activeImg.dataUri;
          a.download = activeImg.name || `image-${Date.now()}.png`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          showToast(`Downloaded ${activeImg.name}`, 'success');
        }
      });

      // 7. Optimizer Events
      document.getElementById('opt-quality-range').addEventListener('input', (e) => {
        document.getElementById('quality-val-display').textContent = `${e.target.value}%`;
      });
      document.getElementById('opt-apply-btn').addEventListener('click', applyOptimization);

      // 8. Embed Codes Tabs & Copy
      document.querySelectorAll('.embed-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.embed-tab-btn').forEach(b => {
            b.classList.remove('active', 'bg-cyan-500', 'text-black', 'shadow-lg', 'shadow-cyan-500/20');
            b.classList.add('bg-dark-bg', 'text-zinc-300', 'border', 'border-dark-border');
          });
          btn.classList.remove('bg-dark-bg', 'text-zinc-300', 'border', 'border-dark-border');
          btn.classList.add('active', 'bg-cyan-500', 'text-black', 'shadow-lg', 'shadow-cyan-500/20');

          AppState.activeEmbedTab = btn.getAttribute('data-tab');
          renderActiveCodeSnippet();
        });
      });

      document.getElementById('toggle-datauri-btn').addEventListener('click', () => {
        AppState.urlMode = 'dataUri';
        document.getElementById('toggle-datauri-btn').className = 'px-2.5 py-1 rounded-lg bg-cyan-500/20 text-cyan-300 font-semibold transition';
        document.getElementById('toggle-hosted-btn').className = 'px-2.5 py-1 rounded-lg text-zinc-400 hover:text-zinc-200 transition';
        renderActiveCodeSnippet();
      });

      document.getElementById('toggle-hosted-btn').addEventListener('click', () => {
        AppState.urlMode = 'hosted';
        document.getElementById('toggle-hosted-btn').className = 'px-2.5 py-1 rounded-lg bg-indigo-500/20 text-indigo-300 font-semibold transition';
        document.getElementById('toggle-datauri-btn').className = 'px-2.5 py-1 rounded-lg text-zinc-400 hover:text-zinc-200 transition';
        renderActiveCodeSnippet();
      });

      document.getElementById('copy-snippet-btn').addEventListener('click', () => {
        const text = document.getElementById('code-snippet-area').value;
        if (text) {
          navigator.clipboard.writeText(text);
          showToast('Code snippet copied!', 'success');
        }
      });

      document.getElementById('download-qr-btn').addEventListener('click', () => {
        const qrCanvas = document.querySelector('#qrcode-render-target canvas');
        const qrImg = document.querySelector('#qrcode-render-target img');
        const src = qrCanvas ? qrCanvas.toDataURL('image/png') : (qrImg ? qrImg.src : null);
        if (src) {
          const a = document.createElement('a');
          a.href = src;
          a.download = `qrcode-${Date.now()}.png`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          showToast('Downloaded QR Code PNG', 'success');
        }
      });

      // 9. Reset Button
      document.getElementById('nav-reset-btn').addEventListener('click', () => {
        AppState.images = [];
        AppState.activeIndex = 0;
        updateWorkspacePresentation();
        updateNavbarStates();
        showToast('Workspace cleared', 'info');
      });

      // 10. Language Modal & Dropdown Toggle
      const langBtn = document.getElementById('lang-menu-btn');
      const langMenu = document.getElementById('lang-dropdown-menu');
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openLanguageModal();
      });

      // Language Modal Events
      const closeLangModalBtn = document.getElementById('close-lang-modal-btn');
      if (closeLangModalBtn) closeLangModalBtn.addEventListener('click', closeLanguageModal);
      const closeLangModalBottom = document.getElementById('lang-modal-close-bottom');
      if (closeLangModalBottom) closeLangModalBottom.addEventListener('click', closeLanguageModal);

      const langModalEl = document.getElementById('language-modal');
      if (langModalEl) {
        langModalEl.addEventListener('click', (e) => {
          if (e.target === langModalEl) {
            closeLanguageModal();
          }
        });
      }

      const langSearchInput = document.getElementById('lang-modal-search');
      if (langSearchInput) {
        langSearchInput.addEventListener('input', (e) => {
          renderLanguageModalGrid(e.target.value);
        });
      }

      // Close modal on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeLanguageModal();
        }
      });

      document.addEventListener('click', (e) => {
        if (!document.getElementById('lang-dropdown-container').contains(e.target)) {
          langMenu.classList.add('hidden');
        }
      });

      // 11. Populate Language Dropdown
      if (langMenu && typeof LANGUAGES !== 'undefined' && Array.isArray(LANGUAGES)) {
        langMenu.innerHTML = LANGUAGES.map(l => `
          <button type="button" onclick="switchLanguage('${l.code}')" class="w-full flex items-center justify-between px-3 py-2 text-xs text-left rounded-xl hover:bg-dark-bg text-zinc-300 hover:text-white transition">
            <div class="flex items-center space-x-2">
              <span class="text-base">${l.flag}</span>
              <span class="font-medium">${escapeHtml(l.nativeName || l.name)}</span>
            </div>
            <span class="text-[10px] uppercase font-mono text-zinc-500">${l.code}</span>
          </button>
        `).join('');
      }

      // 12. Tools Menu Dropdown Toggle
      const toolsBtn = document.getElementById('tools-menu-btn');
      const toolsMenu = document.getElementById('tools-dropdown-menu');
      toolsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toolsMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!document.getElementById('tools-dropdown-container').contains(e.target)) {
          toolsMenu.classList.add('hidden');
        }
      });

      // 13. Mobile Drawer Toggle
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      mobileBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });

      // 14. History Drawer Listeners
      document.getElementById('open-history-btn').addEventListener('click', openHistoryDrawer);
      document.getElementById('close-history-btn').addEventListener('click', () => {
        document.getElementById('history-drawer').classList.add('hidden');
      });
      document.getElementById('clear-history-btn').addEventListener('click', () => {
        localStorage.removeItem('imagetourl_recent');
        openHistoryDrawer();
        updateRecentBadge();
        showToast('History cleared', 'info');
      });

      // Initialize sub-modules
      initBase64Decoder();
      initUrlFetcher();
      initContactForm();
      initFaq();
      updateRecentBadge();

      // Listen for browser route changes (popstate for clean URLs, hashchange for fallback)
      window.addEventListener('popstate', handleRouteUpdate);
      window.addEventListener('hashchange', handleRouteUpdate);

      // Intercept internal link clicks for smooth SPA navigation without page reloads
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (!link) return;

        const href = link.getAttribute('href');
        if (!href) return;

        // Skip external, new tab, mailto, tel, script, or in-page hash links
        if (
          link.target === '_blank' ||
          href.startsWith('http://') ||
          href.startsWith('https://') ||
          href.startsWith('mailto:') ||
          href.startsWith('tel:') ||
          href.startsWith('javascript:') ||
          (href.startsWith('#') && !href.startsWith('#/'))
        ) {
          return;
        }

        e.preventDefault();
        let routePath = href;
        if (routePath.startsWith('#/')) {
          routePath = routePath.replace(/^#/, '');
        }
        const route = parseRouteFromPath(routePath, AppState.currentLang);
        navigateTo(route.lang, route.page);
      });

      // Initial route resolution
      handleRouteUpdate();
    });

    function openHistoryDrawer() {
      const historyDrawer = document.getElementById('history-drawer');
      const listEl = document.getElementById('history-items-list');
      const recent = JSON.parse(localStorage.getItem('imagetourl_recent') || '[]');
      const emptyText = (TRANSLATIONS[AppState.currentLang] && TRANSLATIONS[AppState.currentLang].historyEmpty) || 'No recent conversions saved yet';

      if (recent.length === 0) {
        listEl.innerHTML = `
          <div class="text-center py-8 text-zinc-500 text-xs">
            <i data-lucide="inbox" class="w-8 h-8 mx-auto mb-2 text-zinc-600"></i>
            <p>${escapeHtml(emptyText)}</p>
          </div>
        `;
      } else {
        listEl.innerHTML = recent.map((item, idx) => `
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-dark-bg border border-dark-border hover:border-dark-borderHover transition">
            <div class="flex items-center space-x-2.5 min-w-0">
              <img src="${item.dataUri}" class="w-8 h-8 object-cover rounded-lg border border-dark-border" />
              <div class="min-w-0">
                <div class="text-xs font-semibold text-zinc-200 truncate max-w-[160px]">${escapeHtml(item.name)}</div>
                <div class="text-[10px] text-zinc-500 font-mono">${item.width}×${item.height} • ${formatBytes(item.size)}</div>
              </div>
            </div>
            <div class="flex items-center space-x-1">
              <button type="button" onclick="loadFromHistory(${idx})" title="Load Image" class="p-1.5 rounded-lg text-zinc-400 hover:text-cyan-400 hover:bg-dark-card transition">
                <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        `).join('');
      }

      historyDrawer.classList.remove('hidden');
      if (window.lucide) lucide.createIcons();
    }

    window.loadFromHistory = function (index) {
      const recent = JSON.parse(localStorage.getItem('imagetourl_recent') || '[]');
      const item = recent[index];
      if (item && item.fullDataUri) {
        const blob = dataURItoBlob(item.fullDataUri);
        const file = new File([blob], item.name, { type: item.mimeType || 'image/png' });
        handleFilesSelected([file]);
        document.getElementById('history-drawer').classList.add('hidden');
      }
    };
  </script>
</body>

</html>