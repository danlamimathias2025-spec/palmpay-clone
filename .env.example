# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Paystack API Keys for real account name resolution & bank lookup
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_API_KEY=""
PAYSTACK_KEY=""
BANK_API_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""

# SMSAPI_KEY: Key for sending SMS notifications (supports SMSAPI, Textbelt, or generic key names: SMSAPI_KEY, SMS_API_KEY, TEXTBELT_API_KEY, TEXTBELT)
SMSAPI_KEY=""
SMS_API_KEY=""
TEXTBELT_API_KEY=""

# INTERNAL_API_SECRET: Shared secret key for verifying incoming webhook requests from Site A
INTERNAL_API_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
