            </div>
            <span class="text-base font-extrabold text-white group-hover:text-cyan-300 transition">ImageToURL.org</span>
          </a>
          <span class="text-xs text-zinc-400">•</span>
          <span class="text-xs text-zinc-400" data-i18n="footerTagline">Fast, private &amp; modern client-side image
            processing</span>
        </div>

        <div class="flex items-center space-x-4 text-xs text-zinc-400 font-medium">
          <a href="/contact" id="footer-link-contact" class="hover:text-cyan-400 transition"
            data-i18n="navContact">Contact Us</a>
          <a href="/privacy-policy" id="footer-link-privacy" class="hover:text-cyan-400 transition"
            data-i18n="navPrivacy">Privacy Policy</a>
          <a href="/terms" id="footer-link-terms" class="hover:text-cyan-400 transition" data-i18n="navTerms">Terms of
            Service</a>
        </div>
      </div>

      <!-- Tools Grid -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-zinc-300 uppercase tracking-wider" data-i18n="navTools">Tools</h4>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2 text-xs" id="footer-tools-links">
          <!-- Dynamically populated with localized names -->
        </div>
      </div>

      <!-- Languages Grid -->
      <div class="space-y-3">
