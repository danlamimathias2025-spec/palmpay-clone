                  <label class="text-xs font-semibold text-zinc-300" data-i18n="contactNameLabel">Your Full Name</label>
                  <input type="text" id="contact-name" required placeholder="Alex Morgan"
                    class="w-full bg-[#0a0c12] border border-dark-border rounded-xl px-4 py-2.5 text-xs text-zinc-200 focus:outline-none focus:border-cyan-500 transition" />
                </div>
                <div class="space-y-1.5">
                  <label class="text-xs font-semibold text-zinc-300" data-i18n="contactEmailLabel">Email Address</label>
                  <input type="email" id="contact-email" required placeholder="alex@company.com"
                    class="w-full bg-[#0a0c12] border border-dark-border rounded-xl px-4 py-2.5 text-xs text-zinc-200 focus:outline-none focus:border-cyan-500 transition" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label class="text-xs font-semibold text-zinc-300" data-i18n="contactCategoryLabel">Category</label>
                  <select id="contact-category"
                    class="w-full bg-[#0a0c12] border border-dark-border rounded-xl px-3 py-2.5 text-xs text-zinc-200 focus:outline-none focus:border-cyan-500 transition">
                    <option value="general" data-i18n="catGeneral">General Inquiry</option>
                    <option value="bug" data-i18n="catBug">Report a Bug / Issue</option>
                    <option value="feature" data-i18n="catFeature">Feature Request</option>
                    <option value="api" data-i18n="catApi">Commercial / API Inquiry</option>
                    <option value="feedback" data-i18n="catFeedback">User Feedback</option>
                  </select>
                </div>
                <div class="space-y-1.5">
                  <label class="text-xs font-semibold text-zinc-300" data-i18n="contactSubjectLabel">Subject</label>
                  <input type="text" id="contact-subject" required placeholder="Quick question about PNG conversion"
                    data-i18n-placeholder="contactSubjectPlaceholder"
                    class="w-full bg-[#0a0c12] border border-dark-border rounded-xl px-4 py-2.5 text-xs text-zinc-200 focus:outline-none focus:border-cyan-500 transition" />
                </div>
              </div>

              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <label class="text-xs font-semibold text-zinc-300" data-i18n="contactMessageLabel">Detailed
                    Message</label>
                  <span id="contact-char-count" class="text-[11px] text-zinc-400">0 / 1000</span>
                </div>
                <textarea id="contact-message" rows="5" maxlength="1000" required
                  placeholder="Tell us how we can assist you..." data-i18n-placeholder="contactMessagePlaceholder"
                  class="w-full bg-[#0a0c12] border border-dark-border rounded-xl p-4 text-xs text-zinc-200 focus:outline-none focus:border-cyan-500 transition"></textarea>
              </div>

              <button type="submit" id="contact-submit-btn"
                class="w-full flex items-center justify-center space-x-2 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-bold text-sm shadow-xl shadow-cyan-500/20 transition">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span data-i18n="contactSubmitBtn">Send Message</span>
              </button>
            </form>

            <div id="contact-success-card" class="hidden text-center py-8 space-y-3">
              <div
                class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center">
                <i data-lucide="check-circle-2" class="w-8 h-8"></i>
              </div>
              <h3 class="text-lg font-bold text-white" data-i18n="contactSuccessTitle">Message Sent Successfully!</h3>
              <p class="text-xs text-zinc-400 max-w-sm mx-auto" data-i18n="contactSuccessDesc">Thank you for reaching
                out. Our development team has received your note and will get back to your email within 24 hours.</p>
              <button type="button" id="contact-reset-form-btn" class="mt-2 text-xs text-cyan-400 hover:underline"
                data-i18n="contactResetBtn">Send another message</button>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- VIEW 5: PRIVACY POLICY PAGE -->
    <div id="view-privacy" class="hidden space-y-8 animate-in fade-in duration-300 max-w-4xl mx-auto py-2">
      <div class="text-center space-y-3">
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
          <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
          <span data-i18n="privacyBadge">Privacy Guaranteed</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white" data-i18n="privacyTitle">Privacy
          Policy</h1>
        <p class="text-xs text-zinc-400 font-mono" data-i18n="privacyUpdated">Last updated: September 2026</p>
      </div>

      <div
        class="bg-dark-surface border border-dark-border rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 text-xs sm:text-sm leading-relaxed shadow-2xl">
        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="privacySec1Title">1. 100%
            Client-Side Processing Architecture</h2>
          <p class="text-zinc-400" data-i18n="privacySec1Body">At ImageToURL.org, privacy is not just an afterthought—it
            is the foundational architecture of our software. All image file uploads, resizing, Base64 encodings, and QR
            code generations are executed exclusively in your client-side browser memory via the HTML5 File and Canvas
            APIs. No image data is transmitted to, stored on, or retained by remote servers.</p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="privacySec2Title">2. Local
            Storage &amp; Browser Cookies</h2>
          <p class="text-zinc-400" data-i18n="privacySec2Body">We use your browser&#x27;s local storage (localStorage)
            strictly to preserve your recent conversion history and language preferences for your convenience. This data
            remains on your local machine and can be cleared at any moment using the &#x27;Reset&#x27; or &#x27;Clear
            History&#x27; button. We do not employ tracking cookies, biometric fingerprinting, or invasive surveillance
            scripts.</p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="privacySec3Title">3. GDPR
            &amp; CCPA Compliance</h2>
          <p class="text-zinc-400" data-i18n="privacySec3Body">Because we do not store, process, or sell personal
            identifiers or user files on server infrastructure, ImageToURL inherently satisfies the core privacy
            principles mandated by the General Data Protection Regulation (GDPR) and the California Consumer Privacy Act
            (CCPA).</p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="privacySec4Title">4.
            Third-Party Services</h2>
          <p class="text-zinc-400" data-i18n="privacySec4Body">Our web application uses static asset CDNs (such as
            Tailwind CDN, Google Fonts, and Cloudflare CDN) solely for caching stylesheet libraries and typography.
            These services do not receive or process your uploaded graphics.</p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="privacySec5Title">5. Contact
            Regarding Privacy</h2>
          <p class="text-zinc-400" data-i18n="privacySec5Body">If you have questions or inquiries regarding our privacy
            standards, please reach out directly at <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="c4b4b6adb2a5a7bd84ada9a5a3a1b0abb1b6a8eaabb6a3">[email&#160;protected]</a> or visit our Contact Page.</p>
        </div>
      </div>
    </div>

    <!-- VIEW 6: TERMS OF SERVICE PAGE -->
    <div id="view-terms" class="hidden space-y-8 animate-in fade-in duration-300 max-w-4xl mx-auto py-2">
      <div class="text-center space-y-3">
        <div
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold">
          <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
          <span data-i18n="termsBadge">Usage Guidelines</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white" data-i18n="termsTitle">Terms of
          Service</h1>
        <p class="text-xs text-zinc-400 font-mono" data-i18n="termsUpdated">Effective as of September 2026</p>
      </div>

      <div
        class="bg-dark-surface border border-dark-border rounded-3xl p-6 sm:p-10 space-y-6 text-zinc-300 text-xs sm:text-sm leading-relaxed shadow-2xl">
        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="termsSec1Title">1.
            Acceptance of Terms</h2>
          <p class="text-zinc-400" data-i18n="termsSec1Body">By accessing and utilizing ImageToURL.org, you accept and
            agree to be bound by these terms. If you disagree with any portion of these provisions, you may immediately
            discontinue using the utility.</p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="termsSec2Title">2. Permitted
            Use &amp; Intellectual Property</h2>
          <p class="text-zinc-400" data-i18n="termsSec2Body">ImageToURL is free for personal, commercial, and developer
            use. You retain complete ownership and intellectual property rights over all images you process with this
            service. You agree not to use this utility to generate or distribute malicious, infringing, or harmful
            material.</p>
        </div>

        <div class="space-y-2">
          <h2 class="text-base font-bold text-white flex items-center space-x-2" data-i18n="termsSec3Title">3.
            Disclaimer of Warranties</h2>
          <p class="text-zinc-400" data-i18n="termsSec3Body">This web tool is provided on an &#x27;AS IS&#x27; and
            &#x27;AS AVAILABLE&#x27; basis without warranties of any kind. While we rigorously test cross-browser
            compatibility, we cannot guarantee uninterrupted or error-free execution across every third-party hardware
            configuration.</p>
        </div>
      </div>
    </div>

  </main>

  <!-- RECENT UPLOADS DRAWER -->
  <aside id="history-drawer"
    class="hidden fixed inset-0 z-50 overflow-hidden bg-black/60 backdrop-blur-sm transition-opacity">
    <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
      <div
        class="w-screen max-w-md bg-dark-surface border-l border-dark-border p-6 flex flex-col justify-between shadow-2xl">

        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-dark-border pb-4">
            <div class="flex items-center space-x-2">
              <i data-lucide="history" class="w-5 h-5 text-cyan-400"></i>
              <h3 class="text-base font-bold text-white" data-i18n="historyTitle">Recent Conversions</h3>
            </div>
            <button type="button" id="close-history-btn" class="p-1 rounded-lg text-zinc-400 hover:text-white">
              <i data-lucide="x" class="w-5 h-5"></i>
            </button>
          </div>

          <div id="history-items-list" class="space-y-2 max-h-[calc(100vh-200px)] overflow-y-auto scrollbar-thin">
            <!-- Dynamically populated -->
          </div>
        </div>

        <div class="pt-4 border-t border-dark-border">
          <button type="button" id="clear-history-btn"
            class="w-full py-2.5 rounded-xl bg-dark-bg hover:bg-red-500/10 border border-dark-border hover:border-red-500/30 text-xs font-semibold text-zinc-400 hover:text-red-400 transition">
            <span data-i18n="historyClear">Clear Conversion History</span>
          </button>
        </div>

      </div>
    </div>
  </aside>

  <!-- FULLSCREEN IMAGE LIGHTBOX MODAL -->
  <div id="lightbox-modal"
    class="hidden fixed inset-0 z-50 bg-black/95 backdrop-blur-md flex items-center justify-center p-4">
    <button type="button" id="close-lightbox-btn"
      class="absolute top-4 right-4 p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition">
      <i data-lucide="x" class="w-6 h-6"></i>
    </button>
    <img id="lightbox-img" src="" alt="Fullscreen Preview"
      class="max-w-full max-h-[90vh] object-contain rounded-xl shadow-2xl border border-white/10" />
  </div>


  <!-- LANGUAGE SELECTION MODAL (Grid matching user reference layout) -->
  <div id="language-modal"
    class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-5 overflow-y-auto">
    <div
      class="relative w-full max-w-5xl bg-white dark:bg-[#0d0f17] border border-zinc-200 dark:border-dark-border rounded-3xl shadow-2xl shadow-black/80 overflow-hidden flex flex-col max-h-[92vh] my-auto">
      <!-- Modal Header -->
      <div
        class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-zinc-200 dark:border-dark-border/80 bg-zinc-50/70 dark:bg-dark-card/50">
        <div class="flex items-center space-x-3">
          <div
            class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-500 dark:text-cyan-400 shrink-0">
            <i data-lucide="globe" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-base font-bold text-zinc-900 dark:text-white" data-i18n="modalLangTitle">Select Language
            </h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400" data-i18n="modalLangSubtitle">Choose your preferred
              language across all 42 regional versions</p>
          </div>
        </div>
        <button id="close-lang-modal-btn" type="button" aria-label="Close language selector"
          class="p-2 rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-dark-cardHover transition">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Live Search Bar -->
      <div class="p-3 sm:p-4 border-b border-zinc-100 dark:border-dark-border/60 bg-white dark:bg-dark-surface/60">
        <div class="relative">
          <i data-lucide="search" class="w-4 h-4 text-zinc-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
          <input id="lang-modal-search" type="text"
            placeholder="Search 42 languages by name, native script, or country code..."
            class="w-full pl-10 pr-4 py-2 rounded-xl text-xs bg-zinc-50 dark:bg-dark-card border border-zinc-200 dark:border-dark-border text-zinc-900 dark:text-zinc-200 placeholder-zinc-400 focus:outline-none focus:border-cyan-500 transition" />
        </div>
      </div>

      <!-- Languages Grid Container -->
      <div class="p-4 sm:p-6 overflow-y-auto flex-1">
        <div id="modal-language-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5">
          <!-- Dynamically populated 42 cards -->
        </div>
        <div id="modal-lang-empty" class="hidden py-12 text-center text-xs text-zinc-400">
          No matching languages found
        </div>
      </div>

      <!-- Modal Footer -->
      <div
        class="px-5 sm:px-6 py-3 border-t border-zinc-200 dark:border-dark-border/80 bg-zinc-50 dark:bg-dark-card/60 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>42 Regional Languages &amp; Routes Available</span>
        </div>
        <button id="lang-modal-close-bottom" type="button"
          class="px-3.5 py-1.5 rounded-xl bg-zinc-200 dark:bg-dark-border hover:bg-zinc-300 dark:hover:bg-dark-borderHover text-zinc-700 dark:text-zinc-300 text-xs font-medium transition">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- FLOATING TOAST NOTIFICATION STACK -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none">
    <!-- Generated dynamically -->
  </div>

  <!-- FOOTER -->
  <footer class="mt-auto border-t border-dark-border/80 bg-[#06070a] pt-12 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <div class="flex flex-col md:flex-row items-center justify-between gap-4 border-b border-dark-border/60 pb-8">
        <div class="flex items-center space-x-3">
