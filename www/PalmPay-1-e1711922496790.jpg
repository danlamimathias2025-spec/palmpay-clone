              Languages</h4>
            <span
              class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 font-semibold border border-cyan-500/20">42
              Languages</span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-[11px] text-zinc-400 hidden sm:inline" data-i18n="footerLangDesc">Each language has its
              own unique URL route</span>
            <button type="button" onclick="openLanguageModal()"
              class="text-xs text-cyan-400 hover:text-cyan-300 font-medium flex items-center space-x-1 px-2.5 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/20 hover:bg-cyan-500/20 transition">
              <i data-lucide="globe" class="w-3.5 h-3.5"></i>
              <span>Language Grid</span>
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-7 gap-2 text-xs"
          id="footer-language-links">
          <!-- Dynamically populated -->
        </div>
